{
  "rules": {
    "devices": {
      "$device_id": {
        // Leitura: Permitida apenas se o usuário for o proprietário autenticado do dispositivo
        ".read": "auth != null && (data.child('owner_uid').val() === auth.uid || !data.child('owner_uid').exists())",
        
        // Escrita direta: permitida apenas se o usuário autenticado for o proprietário do dispositivo
        ".write": "auth != null && (data.child('owner_uid').val() === auth.uid || (!data.exists() && newData.child('owner_uid').val() === auth.uid))",
        
        // Sub-nó de envio de tarefas/comandos (dashboard -> UTOME)
        "comando_pendente": {
          ".read": "auth != null && (data.parent().child('owner_uid').val() === auth.uid || !data.parent().child('owner_uid').exists())",
          ".write": "auth != null && (data.parent().child('owner_uid').val() === auth.uid || !data.parent().child('owner_uid').exists())"
        },

        // Sub-nó de configurações (Modo Calmante, Celebração Visual)
        "configs": {
          ".read": "auth != null && (data.parent().child('owner_uid').val() === auth.uid || !data.parent().child('owner_uid').exists())",
          ".write": "auth != null && (data.parent().child('owner_uid').val() === auth.uid || !data.parent().child('owner_uid').exists())"
        }
      }
    }
  }
}
