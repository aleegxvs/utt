rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuários só podem ler e escrever nos SEUS próprios documentos e subcoleções
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcoleção de rotinas
      match /rotinas/{rotinaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Subcoleção de tarefas dentro de cada rotina
        match /tarefas/{tarefaId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Códigos temporários de pareamento: acesso direto do cliente é bloqueado.
    // Manipulado exclusivamente pelo Firebase Admin SDK no Backend.
    match /pairing_codes/{code} {
      allow read, write: if false;
    }
  }
}
