rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USUÁRIOS E DADOS PRIVADOS ──
    // Regra estrita: Cada usuário só pode ler, gravar e modificar seus próprios documentos e subcoleções.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcoleção de rotinas cadastradas pelo responsável
      match /rotinas/{rotinaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Subcoleção de tarefas dentro de cada rotina
        match /tarefas/{tarefaId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Subcoleção de eventos históricos (tarefas concluídas pelo UTOME com 3 toques)
      match /eventos/{eventoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcoleção de configurações adicionais
      match /configuracoes/{configId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── DISPOSITIVOS (METADADOS GLOBAIS) ──
    // Leitura: apenas o usuário autenticado proprietário do dispositivo
    // Escrita: proibida para clientes web; manipulada exclusivamente pelo Backend (Firebase Admin SDK)
    match /devices/{deviceId} {
      allow read: if request.auth != null && resource.data.owner_uid == request.auth.uid;
      allow write: if false;
    }

    // ── CÓDIGOS DE PAREAMENTO (LEGADO / SEGURANÇA) ──
    // Acesso direto do cliente bloqueado completamente.
    match /pairing_codes/{code} {
      allow read, write: if false;
    }
  }
}
